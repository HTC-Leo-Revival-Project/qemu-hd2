<?xml version="1.0" encoding="utf-8"?>
<!-- a hardware key: flat, and lit holo blue while held, like the HD2's key backlight -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="250">
    <item android:state_pressed="true">
        <color android:color="@color/holo_pressed" />
    </item>
    <item android:state_activated="true">
        <color android:color="@color/holo_pressed" />
    </item>
    <item android:state_focused="true">
        <color android:color="@color/holo_focus" />
    </item>
    <item>
        <color android:color="@android:color/transparent" />
    </item>
</selector>
