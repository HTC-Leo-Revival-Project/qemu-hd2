<?xml version="1.0" encoding="utf-8"?>
<!--
  The ICS action bar on Holo dark: near-black, with the holo blue rule along
  its bottom edge.  Insets rather than gravity/height, so it is the same
  drawable on API 15 as on 36.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/holo_blue" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#ff262626"
                android:endColor="#ff1b1b1b" />
        </shape>
    </item>
</layer-list>
