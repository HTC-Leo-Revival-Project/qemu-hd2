<?xml version="1.0" encoding="utf-8"?>
<!-- a hardware key: it lights up like the HD2's key backlight when held -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/holo_pressed" />
            <stroke android:width="1dp" android:color="@color/holo_blue" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/holo_pressed" />
            <stroke android:width="1dp" android:color="@color/holo_blue" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#0affffff" />
            <stroke android:width="1dp" android:color="#12ffffff" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0fffffff" />
            <stroke android:width="1dp" android:color="#1affffff" />
        </shape>
    </item>
</selector>
