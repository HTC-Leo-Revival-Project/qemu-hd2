# The patched QEMU lives in src/qemu; its build directory, and the kernel
# and cLK trees used during development, stay local
/src/qemu/build/
/src/qemu-gpu/
/src/kernel/
/src/kernel-ics/
/src/clk/

# Disk images, firmware downloads and dumps (the NAND dump holds an IMEI
# and radio calibration: never commit it), toolchains, scratch output
/images/
/firmware/
/toolchains/
/build-tmp/
/build/
*.log
*.ppm
qmp.sock
# root-only, so it cannot swallow a source file like ImagesActivity.java
# (it did on a case-insensitive filesystem)
/images*
# Built recovery tool
/tools/recovery/hd2nanddump
__pycache__/
android/app/build
android/build
android/.gradle
android/local.properties
*libhtcleo*.so
android/app/src/main/jniLibs/arm64-v8a/libhtcleo*