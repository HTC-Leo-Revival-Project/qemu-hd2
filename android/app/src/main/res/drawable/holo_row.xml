<?xml version="1.0" encoding="utf-8"?>
<!-- a preference row: a flat holo-blue wash while it is held down -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <color android:color="@color/holo_pressed" />
    </item>
    <item android:state_activated="true">
        <color android:color="@color/holo_focus" />
    </item>
    <item android:state_selected="true">
        <color android:color="@color/holo_focus" />
    </item>
    <item>
        <color android:color="@color/holo_row_bg" />
    </item>
</selector>
