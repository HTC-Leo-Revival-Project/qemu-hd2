<?xml version="1.0" encoding="utf-8"?>
<!--
  The bar the phone's hardware keys sit in, like ICS's split action bar: the
  action bar's black, a hairline along the top.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#ff333333" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#ff1e1e1e"
                android:endColor="#ff141414" />
        </shape>
    </item>
</layer-list>
