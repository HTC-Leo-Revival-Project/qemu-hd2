# The patched QEMU lives in src/qemu; its build directory, and the kernel
# and cLK trees used during development, stay local
/src/qemu/build/
/src/qemu-gpu/
/src/kernel/
/src/kernel-ics/
/src/clk/

# Disk images, firmware downloads and dumps (the NAND dump holds an IMEI
# and radio calibration: never commit it), toolchains, scratch output
/images/
/firmware/
/toolchains/
/build-tmp/
/build/
*.log
*.ppm
qmp.sock
# QEMU's configure test dir / a firmware ELF written into the repo root by
# running tools/hd2_radio.py from the wrong directory (it wants images/)
/config-temp/

# hfsprogs, unpacked from its .deb by tools/mkibootcard.py's README instructions
# rather than installed. hfsprogs is not in a default Ubuntu image and pulling in
# root to add it is more friction than extracting it.
/tools/hfsprogs/
/amss.elf
/dsp1.elf
# root-only, so it cannot swallow a source file like ImagesActivity.java
# (it did on a case-insensitive filesystem)
/images*
# Built recovery tool
/tools/recovery/hd2nanddump
__pycache__/
android/app/build
android/build
android/.gradle
android/local.properties
# the web UI's install and build output
web/node_modules
web/.next
web/next-env.d.ts
web/*.tsbuildinfo
*libhtcleo*.so
android/app/src/main/jniLibs/arm64-v8a/libhtcleo*
tools/ph
tools/androotsh*