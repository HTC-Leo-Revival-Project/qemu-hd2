<?xml version="1.0" encoding="utf-8"?>
<!-- progress_horizontal_holo_dark: the seek bar's rail, a little thicker -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:top="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#40ffffff" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress" android:top="6dp" android:bottom="6dp">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="#4d33b5e5" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress" android:top="6dp" android:bottom="6dp">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/holo_blue" />
            </shape>
        </clip>
    </item>
</layer-list>
